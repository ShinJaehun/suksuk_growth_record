<section class="mx-auto w-full max-w-md pt-8">
  <div class="rounded-lg border border-slate-200 bg-white p-6 shadow-sm">
    <h1 class="text-center text-2xl font-extrabold text-slate-900"><%= t("users.teacher_sessions.title", school: @school.name) %></h1>

    <%= form_with scope: :teacher,
          url: school_teacher_login_path(@school),
          class: "mt-6 space-y-4" do |form| %>
      <%= form.label :login_id, t("users.teacher_sessions.login_id"), class: "block text-sm font-medium" %>
      <%= form.text_field :login_id,
            autofocus: true,
            autocomplete: "username",
            class: "block w-full rounded-lg border border-slate-300 px-3 py-2 text-sm" %>

      <%= form.label :password, t("users.teacher_sessions.password"), class: "block text-sm font-medium" %>
      <%= form.password_field :password,
            autocomplete: "current-password",
            class: "block w-full rounded-lg border border-slate-300 px-3 py-2 text-sm" %>

      <%= form.submit t("users.teacher_sessions.submit"),
            class: "w-full rounded-lg bg-emerald-600 px-4 py-2 text-sm font-semibold text-white" %>
    <% end %>
  </div>
</section>
