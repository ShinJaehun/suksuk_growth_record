<%= render "shared/growth_period_navigation",
      title: l(@recorded_on, format: :long),
      navigation_label: t("student_growth.daily_navigation"),
      previous_label: t("student_growth.previous_record"),
      next_label: t("student_growth.next_record"),
      previous_path: @previous_record_date && growth_record_path(@previous_record_date, classroom: classroom, student: student),
      next_path: @next_record_date && growth_record_path(@next_record_date, classroom: classroom, student: student),
      data_key: :record_navigation,
      navigation_data: { growth_date: @recorded_on.iso8601 } %>
