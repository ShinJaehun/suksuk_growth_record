<section class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm"
         data-daily-growth-record>
  <% if eyebrow.present? %>
    <p class="text-sm font-semibold text-blue-600"><%= eyebrow %></p>
  <% end %>

  <h2 class="<%= eyebrow.present? ? "mt-1 " : "" %>text-xl font-extrabold tracking-tight text-slate-900">
    <%= t("daily_growth_records.result_title") %>
  </h2>

  <% if status_text.present? %>
    <p class="mt-2 text-sm text-slate-700"><%= status_text %></p>
  <% end %>

  <% if record %>
    <div class="mt-5 space-y-5">
      <% score_rows.each do |score| %>
        <article data-daily-score="<%= score.fetch(:virtue_id) %>">
          <div class="flex items-center justify-between gap-4">
            <h3 class="font-bold text-slate-900"><%= score.fetch(:name) %></h3>
            <span class="shrink-0 text-sm font-extrabold text-slate-700">
              <%= t("daily_growth_records.score_value", score: score.fetch(:value)) %>
            </span>
          </div>
          <div class="mt-2 h-3 overflow-hidden rounded-full bg-slate-100">
            <div class="h-full rounded-full"
                 data-score-bar
                 style="width: <%= score.fetch(:value) * 20 %>%; background-color: <%= score.fetch(:color) %>"></div>
          </div>
          <p class="mt-2 text-sm text-slate-600"><%= score.fetch(:label) %></p>
        </article>
      <% end %>
    </div>

    <% if record.reflection.present? %>
      <section class="mt-6 border-t border-slate-100 pt-5">
        <h3 class="text-lg font-bold text-slate-900"><%= t("daily_growth_records.reflection.result_label") %></h3>
        <p class="mt-3 whitespace-pre-wrap text-slate-800"><%= record.reflection %></p>
      </section>
    <% end %>

    <% if edit_path.present? %>
      <div class="mt-6 flex justify-end border-t border-slate-100 pt-5">
        <%= link_to t("daily_growth_records.actions.update"),
              edit_path,
              class: "inline-flex min-h-11 items-center justify-center rounded-xl border border-blue-200 bg-blue-50 px-4 py-2 text-sm font-bold text-blue-700 hover:bg-blue-100",
              data: { edit_today_growth: true } %>
      </div>
    <% end %>
  <% end %>
</section>
