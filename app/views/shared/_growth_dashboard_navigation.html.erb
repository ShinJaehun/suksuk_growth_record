<nav class="mx-auto grid w-full max-w-md grid-cols-3 overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm"
     aria-label="<%= t("student_growth.dashboard_navigation") %>"
     data-growth-dashboard-navigation>
  <%= link_to today_path,
        class: class_names(
          "flex min-h-14 flex-col items-center justify-center gap-1 px-3 py-2 text-center transition",
          "bg-blue-50 text-blue-700" => active == :today,
          "text-slate-600 hover:bg-slate-50" => active != :today
        ),
        aria: { current: active == :today ? "page" : nil },
        data: { growth_tab: "today" } do %>
    <span class="text-lg" aria-hidden="true">📝</span>
    <span class="text-xs font-semibold sm:text-sm"><%= t("student_app.navigation.today") %></span>
  <% end %>

  <%= link_to growth_path,
        class: class_names(
          "flex min-h-14 flex-col items-center justify-center gap-1 border-x border-slate-200 px-3 py-2 text-center transition",
          "bg-blue-50 text-blue-700" => active == :growth,
          "text-slate-600 hover:bg-slate-50" => active != :growth
        ),
        aria: { current: active == :growth ? "page" : nil },
        data: { growth_tab: "growth" } do %>
    <span class="text-lg" aria-hidden="true">📈</span>
    <span class="text-xs font-semibold sm:text-sm"><%= t("student_app.navigation.growth") %></span>
  <% end %>

  <span class="flex min-h-14 cursor-default flex-col items-center justify-center gap-1 bg-slate-50/50 px-3 py-2 text-center text-slate-400"
        aria-disabled="true"
        title="<%= t("student_app.navigation.coming_soon") %>"
        data-growth-tab="monthly">
    <span class="text-lg" aria-hidden="true">📅</span>
    <span class="text-xs font-semibold sm:text-sm"><%= t("student_app.navigation.monthly") %></span>
  </span>
</nav>
