<section class="space-y-4" data-growth-section="weekly">
  <%= render "shared/growth_period_navigation",
        title: t("student_growth.week_range", start: l(@week_start, format: :growth_week), end: l(@chart_end, format: :growth_week)),
        navigation_label: t("student_growth.week_navigation"),
        previous_label: t("student_growth.previous_week"),
        next_label: t("student_growth.next_week"),
        previous_path: growth_dashboard_path(classroom: classroom, student: student, **growth_visualization_params(classroom: classroom), week_offset: @week_offset - 1),
        next_path: @week_offset.negative? ? growth_dashboard_path(classroom: classroom, student: student, **growth_visualization_params(classroom: classroom), week_offset: @week_offset + 1) : nil,
        data_key: :week_navigation,
        navigation_data: { week_start: @week_start.iso8601, week_end: @chart_end.iso8601 } %>

  <%= render "shared/growth_metric_navigation", classroom: classroom, student: student,
        period: growth_visualization_params(classroom: classroom) %>

  <% if @holidays_unavailable %>
    <p class="growth-monthly__notice" role="status"><%= t("student_growth.monthly.holidays_unavailable") %></p>
  <% end %>

  <% chart = student_growth_chart(@weekly_data, overall: @metric == "overall", classroom: classroom, student: student) %>
  <% chart_color = student_growth_color(@selected_virtue) %>
  <article class="rounded-2xl border border-slate-200 bg-white p-2 shadow-sm sm:p-3">
    <div class="overflow-x-auto rounded-xl bg-gradient-to-b from-blue-50 to-white px-1 py-2">
      <svg viewBox="-30 0 525 270"
           class="h-auto w-full"
           role="group"
           aria-label="<%= t("student_growth.chart_label", metric: @selected_virtue&.name || t("student_growth.overall")) %>"
           data-growth-chart="weekly"
           data-growth-metric="<%= @metric %>">
        <% chart[:ticks].reverse_each do |tick| %>
          <line x1="35" y1="<%= tick[:y] %>" x2="470" y2="<%= tick[:y] %>"
                stroke="#dbeafe" stroke-width="<%= tick[:value].zero? ? 2 : 1 %>" />
          <text x="27" y="<%= tick[:y] + 4 %>" text-anchor="end"
                fill="#94a3b8" class="text-[18px] font-semibold"
                data-y-axis-tick="<%= tick[:value] %>"><%= tick[:label] %></text>
        <% end %>

        <% chart[:paths].each do |path| %>
          <path d="<%= path %>" fill="none" stroke="<%= chart_color %>" stroke-width="5"
                stroke-linecap="round" stroke-linejoin="round" />
        <% end %>

        <% chart[:points].each do |point| %>
          <%= content_tag point[:href] ? :a : :g,
                href: point[:href], class: "growth-weekly__day",
                aria: { current: point[:selected] ? "date" : nil,
                        label: t("student_growth.point_label", date: l(point[:date], format: :growth_day), weekday: point[:weekday], value: point[:label]) },
                data: { graph_date: point[:date].iso8601, growth_value: point[:value].to_s } do %>
            <title><%= t("student_growth.point_label", date: l(point[:date], format: :growth_day), weekday: point[:weekday], value: point[:label]) %></title>
            <% if point[:selected] %>
              <rect x="<%= point[:x] - 35 %>" y="196" width="70" height="64" rx="12" fill="#dbeafe" />
            <% end %>
            <% unless point[:value].nil? %>
              <circle cx="<%= point[:x] %>" cy="<%= point[:y] %>" r="6"
                      fill="<%= chart_color %>" stroke="#ffffff" stroke-width="3" />
            <% end %>
            <rect x="<%= point[:x] - 35 %>" y="196" width="70" height="64" fill="transparent" />
            <text x="<%= point[:x] %>" y="220" text-anchor="middle"
                  class="fill-slate-800 text-[20px] font-extrabold"><%= point[:weekday] %></text>
            <text x="<%= point[:x] %>" y="246" text-anchor="middle"
                  class="fill-slate-500 text-[18px] font-semibold"><%= l(point[:date], format: :growth_day) %></text>
          <% end %>
        <% end %>
      </svg>
    </div>
  </article>
</section>
