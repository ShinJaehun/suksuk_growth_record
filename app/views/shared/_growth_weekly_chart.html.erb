<section class="space-y-4" data-growth-section="weekly">
  <h2 class="text-xl font-extrabold tracking-tight text-slate-900"><%= t("student_growth.weekly_title") %></h2>

  <nav class="flex items-center justify-between gap-3"
       aria-label="<%= t("student_growth.week_navigation") %>"
       data-week-start="<%= @week_start.iso8601 %>"
       data-week-end="<%= @chart_end.iso8601 %>">
    <%= link_to growth_dashboard_path(
          tab: "weekly",
          classroom: classroom,
          student: student,
          week_offset: @week_offset - 1,
          metric: @metric
        ),
          aria: { label: t("student_growth.previous_week") },
          data: { week_navigation: "previous" },
          class: "inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-slate-100 text-xl font-bold text-slate-700 hover:bg-slate-200" do %>
      <span aria-hidden="true">←</span>
    <% end %>
    <p class="text-center text-sm font-extrabold text-slate-800 sm:text-xl">
      <%= t("student_growth.week_range", start: l(@week_start, format: :growth_week), end: l(@chart_end, format: :growth_week)) %>
    </p>
    <% if @week_offset.negative? %>
      <%= link_to growth_dashboard_path(
            tab: "weekly",
            classroom: classroom,
            student: student,
            week_offset: @week_offset + 1,
            metric: @metric
          ),
            aria: { label: t("student_growth.next_week") },
            data: { week_navigation: "next" },
            class: "inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-slate-100 text-xl font-bold text-slate-700 hover:bg-slate-200" do %>
        <span aria-hidden="true">→</span>
      <% end %>
    <% else %>
      <span class="inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-slate-50 text-xl text-slate-300"
            aria-disabled="true"
            aria-label="<%= t("student_growth.next_week") %>">
        <span aria-hidden="true">→</span>
      </span>
    <% end %>
  </nav>

  <nav class="flex gap-2 overflow-x-auto pb-2" aria-label="<%= t("student_growth.metric_navigation") %>">
    <%= student_growth_metric_link(
          "overall",
          t("student_growth.overall"),
          href: growth_dashboard_path(
            tab: "weekly",
            classroom: classroom,
            student: student,
            week_offset: @week_offset,
            metric: "overall"
          ),
          current_metric: @metric
        ) %>
    <% @virtues.each do |virtue| %>
      <%= student_growth_metric_link(
            virtue.id.to_s,
            virtue.name,
            href: growth_dashboard_path(
              tab: "weekly",
              classroom: classroom,
              student: student,
              week_offset: @week_offset,
              metric: virtue.id
            ),
            current_metric: @metric,
            color: virtue.color_hex
          ) %>
    <% end %>
  </nav>

  <% chart = student_growth_chart(@weekly_data, overall: @metric == "overall") %>
  <% chart_color = student_growth_color(@selected_virtue) %>
  <article class="rounded-2xl border border-slate-200 bg-white p-4 shadow-sm sm:p-6">
    <div class="overflow-x-auto rounded-xl bg-gradient-to-b from-blue-50 to-white px-3 py-4">
      <svg viewBox="0 0 500 230"
           class="h-auto min-w-[560px] w-full"
           role="img"
           aria-label="<%= t("student_growth.chart_label", metric: @selected_virtue&.name || t("student_growth.overall")) %>"
           data-growth-chart="weekly"
           data-growth-metric="<%= @metric %>">
        <% chart[:ticks].reverse_each do |tick| %>
          <line x1="35" y1="<%= tick[:y] %>" x2="470" y2="<%= tick[:y] %>"
                stroke="#dbeafe" stroke-width="<%= tick[:value].zero? ? 2 : 1 %>" />
          <text x="27" y="<%= tick[:y] + 4 %>" text-anchor="end"
                fill="#94a3b8" class="text-[10px] font-semibold"
                data-y-axis-tick="<%= tick[:value] %>"><%= tick[:label] %></text>
        <% end %>

        <% chart[:paths].each do |path| %>
          <path d="<%= path %>" fill="none" stroke="<%= chart_color %>" stroke-width="5"
                stroke-linecap="round" stroke-linejoin="round" />
        <% end %>

        <% chart[:points].each do |point| %>
          <g data-graph-date="<%= point[:date].iso8601 %>" data-growth-value="<%= point[:value] %>">
            <title><%= t("student_growth.point_label", date: l(point[:date], format: :growth_day), weekday: point[:weekday], value: point[:label]) %></title>
            <% unless point[:value].nil? %>
              <circle cx="<%= point[:x] %>" cy="<%= point[:y] %>" r="6"
                      fill="<%= chart_color %>" stroke="#ffffff" stroke-width="3" />
            <% end %>
            <text x="<%= point[:x] %>" y="185" text-anchor="middle"
                  class="fill-slate-800 text-[11px] font-extrabold"><%= point[:weekday] %></text>
            <text x="<%= point[:x] %>" y="204" text-anchor="middle"
                  class="fill-slate-500 text-[10px] font-semibold"><%= l(point[:date], format: :growth_day) %></text>
          </g>
        <% end %>
      </svg>
    </div>
  </article>
</section>
