<%# locals: (student:, classroom:) %>

<div class="flex min-w-0 items-center gap-4" data-student-identity>
  <%= student_avatar_image(
        student,
        size: 512,
        class: "h-24 w-24 shrink-0 rounded-2xl border border-slate-200 bg-slate-100 object-contain",
        alt: "#{student.name} avatar"
      ) %>

  <div class="min-w-0 flex-1">
    <p class="truncate text-lg font-semibold text-slate-700"
       data-student-school
       data-student-identity-field="school">
      <%= classroom.school_year.school.name %>
    </p>
    <p class="mt-0.5 truncate text-sm text-slate-500"
       data-student-classroom
       data-student-identity-field="classroom">
      <%= classroom_display_name(classroom) %>
      <span class="mx-1 text-slate-300">·</span>
      <%= if student.student_number.present?
            t("students.edit.self_pin.student_number_value", number: student.student_number)
          else
            t("students.edit.self_pin.unassigned_student_number")
          end %>
    </p>
    <h1 class="mt-1 truncate text-2xl font-extrabold tracking-tight text-slate-900"
        data-student-name
        data-student-identity-field="name">
      <%= student.name %>
    </h1>
  </div>
</div>
