<header class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
  <p class="text-sm font-semibold text-blue-600"><%= l(Time.zone.today, format: :long) %></p>
  <h1 class="mt-1 text-2xl font-extrabold tracking-tight text-slate-900">
    <%= t("daily_growth_records.title") %>
  </h1>
</header>

<%= form_with url: student_growth_record_path,
      scope: :daily_growth_record,
      method: @record ? :patch : :post,
      class: "space-y-6",
      data: { turbo_submits_with: t("ui.processing"), growth_today_form: true } do %>
  <div class="space-y-4">
    <% @virtue_fields.each do |virtue| %>
      <fieldset class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
        <legend class="px-1 text-lg font-bold text-slate-900"><%= virtue.fetch(:name) %></legend>

        <div class="mt-3 grid gap-2 sm:grid-cols-5">
          <% (1..5).each do |score| %>
            <label class="flex min-h-14 cursor-pointer items-center gap-3 rounded-xl border border-slate-200 px-3 py-3 text-sm text-slate-700 hover:border-blue-300 hover:bg-blue-50 sm:flex-col sm:justify-center sm:text-center">
              <%= radio_button_tag "daily_growth_record[scores][#{virtue.fetch(:id)}]",
                    score,
                    @selected_scores[virtue.fetch(:id).to_s].to_i == score,
                    required: true,
                    class: "h-5 w-5 border-slate-300 text-blue-600 focus:ring-blue-500" %>
              <span>
                <strong class="block text-base text-slate-900"><%= score %></strong>
                <%= t("daily_growth_records.score_labels.#{score}") %>
              </span>
            </label>
          <% end %>
        </div>
      </fieldset>
    <% end %>
  </div>

  <section class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
    <label for="daily_growth_record_reflection" class="block text-lg font-bold text-slate-900">
      <%= t("daily_growth_records.reflection.label") %>
      <span class="ml-1 text-sm font-medium text-slate-500"><%= t("daily_growth_records.reflection.optional") %></span>
    </label>
    <%= text_area_tag "daily_growth_record[reflection]",
          @reflection,
          id: "daily_growth_record_reflection",
          rows: 5,
          placeholder: t("daily_growth_records.reflection.placeholder"),
          class: "mt-3 block w-full rounded-xl border-slate-300 text-base shadow-sm focus:border-blue-500 focus:ring-blue-500" %>
  </section>

  <div class="flex justify-end">
    <%= submit_tag t(@record ? "daily_growth_records.actions.update" : "daily_growth_records.actions.create"),
          class: "min-h-12 w-full rounded-xl bg-blue-600 px-5 py-3 text-base font-bold text-white hover:bg-blue-700 sm:w-auto" %>
  </div>
<% end %>
