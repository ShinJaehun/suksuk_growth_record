<section class="mx-auto w-full max-w-3xl space-y-6 pt-4">
  <section class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
    <div class="flex flex-col gap-4 sm:flex-row sm:items-start">
      <%= student_avatar_image(
            current_student,
            class: "h-24 w-24 shrink-0 rounded-2xl border border-slate-200 bg-slate-100 object-contain",
            alt: "#{current_student.name} avatar"
          ) %>

      <div class="min-w-0 flex-1">
        <h1 class="text-2xl font-extrabold tracking-tight text-slate-900"><%= current_student.name %></h1>
        <p class="mt-1 text-sm font-medium text-slate-500">
          <%= classroom_display_name(current_student.classroom) %>
        </p>
        <p class="mt-2 text-sm text-slate-700">
          <%= if current_student.student_number.present?
                t("students.edit.self_pin.student_number_value", number: current_student.student_number)
              else
                t("students.edit.self_pin.unassigned_student_number")
              end %>
        </p>
      </div>
    </div>

    <div class="mt-5 flex flex-wrap justify-end gap-2 border-t border-slate-100 pt-4">
      <%= link_to t("students.show.actions.edit_pin"),
            edit_student_pin_path,
            class: "inline-flex rounded-lg border border-blue-300 bg-white px-3 py-2 text-sm font-semibold text-blue-700 hover:bg-blue-50" %>
      <%= button_to t("student_sessions.logout"),
            destroy_student_session_path,
            method: :delete,
            class: "inline-flex rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm font-semibold text-slate-700 hover:bg-slate-50" %>
    </div>
  </section>
</section>
