<section class="mx-auto w-full max-w-3xl space-y-6 pt-4">
  <header class="flex items-center justify-between gap-4">
    <h1 class="text-3xl font-extrabold tracking-tight text-slate-900">
      <%= t("students.edit.self_pin.title") %>
    </h1>
    <%= link_to t("students.edit.back_to_student"),
          student_profile_path,
          class: "inline-flex rounded-lg border border-slate-300 bg-white px-4 py-2 text-sm font-semibold text-slate-700 hover:bg-slate-50" %>
  </header>

  <% if current_student.errors.any? %>
    <div role="alert" class="rounded-2xl border border-rose-200 bg-rose-50 px-5 py-4 text-sm font-medium text-rose-700">
      <%= current_student.errors.full_messages.to_sentence %>
    </div>
  <% end %>

  <section class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
    <div class="flex items-center gap-4">
      <%= student_avatar_image(
            current_student,
            class: "h-20 w-20 rounded-xl border border-slate-200 bg-slate-100 object-contain",
            alt: "#{current_student.name} avatar"
          ) %>
      <div>
        <p class="font-semibold text-slate-900"><%= current_student.name %></p>
        <p class="text-sm text-slate-600"><%= classroom_display_name(current_student.classroom) %></p>
      </div>
    </div>

    <%= form_with model: current_student,
          url: student_pin_path,
          method: :patch,
          class: "mt-6 space-y-5" do |form| %>
      <div>
        <%= form.label :student_pin, t("students.edit.self_pin.new_pin"), class: "mb-2 block text-sm font-medium text-slate-700" %>
        <%= form.password_field :student_pin,
              value: nil,
              maxlength: 4,
              inputmode: "numeric",
              pattern: "\d{4}",
              autocomplete: "new-password",
              class: "block w-full rounded-xl border border-slate-300 px-4 py-3 text-sm" %>
      </div>
      <div>
        <%= form.label :student_pin_confirmation, t("students.edit.self_pin.confirmation"), class: "mb-2 block text-sm font-medium text-slate-700" %>
        <%= form.password_field :student_pin_confirmation,
              value: nil,
              maxlength: 4,
              inputmode: "numeric",
              pattern: "\d{4}",
              autocomplete: "new-password",
              class: "block w-full rounded-xl border border-slate-300 px-4 py-3 text-sm" %>
      </div>
      <div class="flex justify-end">
        <%= form.submit t("students.edit.self_pin.submit"),
              data: { turbo_submits_with: t("ui.processing") },
              class: "inline-flex rounded-lg bg-blue-600 px-4 py-2 text-sm font-semibold text-white hover:bg-blue-700" %>
      </div>
    <% end %>
  </section>
</section>
