<%= turbo_frame_tag dom_id(user) do %>
  <div class="h-full rounded-2xl border border-slate-200 bg-white p-4 shadow-sm"
       data-student-card
       data-student-id="<%= user.id %>">
    <div class="flex items-center gap-3">
      <%= user_avatar_image(user, size: 128,
            class: "h-12 w-12 rounded-xl object-cover border border-slate-200 bg-slate-100",
            alt: "#{display_name(user)} avatar") %>
      <div class="min-w-0">
        <div class="text-xs font-medium text-slate-500" data-student-number>
          <% if student_membership.student_number.present? %>
            <%= t("students.roster.student_number_value", number: student_membership.student_number) %>
          <% else %>
            <%= t("students.roster.unassigned_student_number") %>
          <% end %>
        </div>
        <p class="font-semibold text-slate-800">
          <%= link_to display_name(user),
                      classroom_student_path(classroom, user),
                      data: { turbo: false },
                      class: "text-sky-700 hover:underline" %>
        </p>
      </div>
    </div>
  </div>
<% end %>
