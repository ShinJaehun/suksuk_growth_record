<section class="mx-auto w-full max-w-3xl space-y-6 pt-4">
  <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
    <div class="flex items-center gap-4">
      <%= user_avatar_image(
            @user,
            size: 512,
            class: "h-24 w-24 rounded-2xl border border-slate-200 bg-slate-100 object-cover",
            alt: t("navigation.avatar_alt", name: @user.name)
          ) %>
      <div>
        <h1 class="text-2xl font-extrabold tracking-tight text-slate-900"><%= @user.name %></h1>
        <% if @visible_classrooms.any? %>
          <p class="mt-1 text-sm font-medium text-slate-500"><%= @visible_classrooms.map(&:name).join(", ") %></p>
        <% end %>
      </div>
    </div>

    <div class="mt-5 flex justify-end border-t border-slate-100 pt-4">
      <%= link_to t("navigation.account.finish"),
            destroy_student_session_path,
            data: { turbo_method: :delete },
            class: "inline-flex rounded-lg border border-rose-300 px-4 py-2 text-sm font-semibold text-rose-700 hover:bg-rose-50" %>
    </div>
  </div>
</section>
