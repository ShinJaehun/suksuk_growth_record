<section class="mx-auto max-w-3xl space-y-6 pt-4">
  <header>
    <h1 class="text-3xl font-extrabold"><%= t("admin.teachers.edit_title") %></h1>
  </header>
  <%= render "form" %>
  <% if @teacher.active? && policy(@teacher).deactivate_teacher? %>
    <%= button_to t("teacher_status.deactivate"), deactivate_teacher_path(@teacher),
          method: :patch,
          class: "rounded-lg border border-rose-300 bg-rose-50 px-4 py-2 font-semibold text-rose-700 hover:bg-rose-100" %>
  <% elsif @teacher.inactive? && policy(@teacher).reactivate_teacher? %>
    <%= button_to t("teacher_status.reactivate"), reactivate_teacher_path(@teacher),
          method: :patch,
          class: "rounded-lg border border-emerald-300 bg-emerald-50 px-4 py-2 font-semibold text-emerald-700 hover:bg-emerald-100" %>
  <% end %>
</section>
