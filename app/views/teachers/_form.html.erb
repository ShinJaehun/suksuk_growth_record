<% teacher_avatar_keys = User.avatar_keys_for_role("teacher") %>
<% avatar_image_sources = teacher_avatar_keys.index_with { |avatar_key| asset_path("avatars/#{avatar_key}.png") } %>

<%= form_with model: @teacher,
      url: @teacher.persisted? ? teacher_path(@teacher) : teachers_path,
      class: "space-y-6",
      data: {
        controller: "teacher-avatar-preview",
        teacher_avatar_preview_male_keys_value: User::TEACHER_MALE_AVATAR_KEYS,
        teacher_avatar_preview_female_keys_value: User::TEACHER_FEMALE_AVATAR_KEYS,
        teacher_avatar_preview_all_keys_value: teacher_avatar_keys,
        teacher_avatar_preview_image_sources_value: avatar_image_sources
      } do |f| %>
  <% if @teacher.errors.any? %>
    <div class="rounded-lg bg-rose-50 px-3 py-2 text-sm text-rose-700">
      <%= @teacher.errors.full_messages.to_sentence %>
    </div>
  <% end %>

  <section class="space-y-4 rounded-2xl border border-slate-200 bg-white p-5">
    <% if current_user.admin? %>
      <div>
        <%= label_tag :school_id, t("admin.teachers.form.school_label"), class: "block text-sm font-medium" %>
        <%= select_tag :school_id,
              options_from_collection_for_select(@schools, :id, :name, @selected_school_id),
              include_blank: t("admin.teachers.form.school_unspecified"),
              class: "mt-1 block w-full rounded border px-3 py-2" %>
      </div>
    <% else %>
      <p class="text-sm font-semibold text-slate-700"><%= @schools.first.name %></p>
    <% end %>
    <div>
      <%= f.label :name, t("ui.user_labels.name"), class: "block text-sm font-medium" %>
      <%= f.text_field :name, class: "mt-1 block w-full rounded border px-3 py-2" %>
    </div>
    <div>
      <%= f.label :email, t("ui.user_labels.email"), class: "block text-sm font-medium" %>
      <%= f.email_field :email, class: "mt-1 block w-full rounded border px-3 py-2" %>
    </div>
    <% unless @teacher.persisted? %>
      <div>
        <%= f.label :password, t("admin.teachers.form.password_label"), class: "block text-sm font-medium" %>
        <%= f.password_field :password, class: "mt-1 block w-full rounded border px-3 py-2" %>
      </div>
      <div>
        <%= f.label :password_confirmation, t("schools.teachers.form.password_confirmation_label"), class: "block text-sm font-medium" %>
        <%= f.password_field :password_confirmation, class: "mt-1 block w-full rounded border px-3 py-2" %>
      </div>
    <% end %>
    <div>
      <%= f.label :gender, t("admin.teachers.form.gender_label"), class: "block text-sm font-medium" %>
      <%= f.select :gender,
            [[t("admin.teachers.form.gender_male"), "male"], [t("admin.teachers.form.gender_female"), "female"]],
            { include_blank: t("admin.teachers.form.gender_prompt") },
            class: "mt-1 block w-full rounded border px-3 py-2",
            data: { action: "teacher-avatar-preview#update", teacher_avatar_preview_target: "gender" } %>
    </div>
    <%= f.hidden_field :avatar_key, data: { teacher_avatar_preview_target: "avatarKey" } %>
    <div data-teacher-avatar-preview-target="avatarSection"
         <%= "hidden" unless User.avatar_keys_for(@teacher.gender).include?(@teacher.avatar_key) %>>
      <div class="flex items-center gap-3">
        <%= user_avatar_image(
              @teacher,
              size: 128,
              class: "h-20 w-20 rounded-xl object-cover",
              alt: "#{display_name(@teacher)} avatar",
              data: { teacher_avatar_preview_target: "image" }
            ) %>
        <button type="button"
                class="rounded-lg border border-slate-300 px-4 py-2 text-sm font-semibold"
                aria-expanded="false"
                data-action="teacher-avatar-preview#togglePicker">
          <%= t("admin.teachers.form.avatar_select") %>
        </button>
      </div>
      <div hidden class="mt-3 grid grid-cols-6 gap-2" data-teacher-avatar-preview-target="picker">
        <% teacher_avatar_keys.each do |avatar_key| %>
          <button type="button"
                  class="relative cursor-pointer rounded border p-2"
                  aria-pressed="false"
                  data-avatar-key="<%= avatar_key %>"
                  data-action="teacher-avatar-preview#select"
                  data-teacher-avatar-preview-target="option">
            <%= image_tag "avatars/#{avatar_key}.png", class: "h-12 w-12 rounded-lg object-cover", alt: avatar_key %>
            <span hidden data-teacher-avatar-preview-target="check">✓</span>
          </button>
        <% end %>
      </div>
    </div>
  </section>

  <section class="rounded-2xl border border-slate-200 bg-white p-5">
    <%= hidden_field_tag "classroom_ids[]", "" %>
    <% @schools.each do |school| %>
      <fieldset class="space-y-2">
        <legend class="font-semibold"><%= school.name %></legend>
        <% @classrooms_by_school.fetch(school, []).each do |classroom| %>
          <label class="flex items-center gap-2">
            <%= check_box_tag "classroom_ids[]", classroom.id, @selected_classroom_ids.include?(classroom.id) %>
            <%= classroom_display_name(classroom) %>
          </label>
        <% end %>
      </fieldset>
    <% end %>
  </section>
  <%= f.submit t("ui.save"), class: "rounded-lg bg-blue-600 px-4 py-2 font-semibold text-white" %>
<% end %>
