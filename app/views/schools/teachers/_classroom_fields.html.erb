<h2 class="mb-3 text-base font-semibold"><%= t("schools.teachers.classroom_assignment_title") %></h2>
<p class="mb-3 text-sm text-slate-500"><%= t("schools.teachers.classrooms_help") %></p>

<% if classrooms.none? %>
  <p class="mb-4 text-xs text-gray-500"><%= t("schools.teachers.classrooms_empty") %></p>
<% else %>
  <%= select_tag :classroom_id,
        options_for_select(
          [[t("admin.teachers.index.unassigned_grade"), ""]] +
            classrooms.map { |classroom| [classroom_display_name(classroom), classroom.id] },
          selected_classroom_id
        ),
        class: "mb-4 block w-full rounded border border-slate-300 px-3 py-2" %>
<% end %>
