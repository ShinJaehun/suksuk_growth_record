<section class="mx-auto w-full max-w-md pt-8">
  <div class="rounded-lg border border-slate-200 bg-white p-6 shadow-sm">

    <h1 class="text-center text-2xl font-extrabold text-slate-900"><%= t("navigation.brand") %></h1>
    
    <p class="mt-2 text-center text-sm text-slate-600"><%= t("users.sessions.admin_title") %></p>

    <%= simple_form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "mt-6 space-y-4" }) do |f| %>
      <%= f.input :email,
            required: false,
            autofocus: true,
            label: t("users.sessions.email"),
            input_html: {
              autocomplete: "email",
              class: "block w-full rounded-lg border border-slate-300 px-3 py-2 text-sm"
            } %>

      <%= f.input :password,
            required: false,
            label: t("users.sessions.password"),
            input_html: {
              autocomplete: "current-password",
              class: "block w-full rounded-lg border border-slate-300 px-3 py-2 text-sm"
            } %>

      <%= f.input :remember_me,
            as: :boolean,
            label: t("users.sessions.remember_me") if devise_mapping.rememberable? %>

      <%= f.button :submit,
            t("users.sessions.submit"),
            class: "w-full rounded-lg bg-emerald-600 px-4 py-2 text-sm font-semibold text-white hover:bg-emerald-700" %>
    <% end %>

    <div class="mt-5 border-t border-slate-100 pt-4 text-sm">
      <%= render "devise/shared/links" %>
    </div>
  </div>
</section>
