<section class="mx-auto w-full max-w-3xl space-y-6 pt-4">
  <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
    <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
      <div>
        <h1 class="text-2xl font-extrabold tracking-tight text-slate-900">내 정보 수정</h1>
        <p class="mt-1 text-sm text-slate-500">
          이름, 아바타, 이메일과 비밀번호를 수정할 수 있습니다.
        </p>
      </div>

      <%= link_to "마이페이지로 돌아가기",
            user_path(resource),
            class: "inline-flex items-center rounded-lg border border-slate-300 bg-white px-4 py-2 text-sm font-semibold text-slate-700 hover:bg-slate-50" %>
    </div>
  </div>

  <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
    <div class="mb-5 flex items-start gap-4">
      <%= user_avatar_image(resource,
            size: 512,
            class: "h-24 w-24 rounded-2xl object-cover border border-slate-200 bg-slate-100",
            alt: "#{resource.name} avatar") %>
      <div class="space-y-1 text-sm text-slate-600">
        <p class="font-semibold text-slate-900">현재 아바타</p>
        <p>업로드한 아바타가 있으면 우선 표시되고, 없으면 기본 아바타가 보입니다.</p>
        <% if resource.avatar.attached? %>
          <p class="text-emerald-700">업로드된 아바타를 사용 중입니다.</p>
        <% else %>
          <p class="text-slate-500">현재 기본 아바타를 사용 중입니다.</p>
        <% end %>
      </div>
    </div>

    <%= simple_form_for(resource,
          as: resource_name,
          url: registration_path(resource_name),
          html: { method: :put, multipart: true }) do |f| %>
      <%= f.error_notification %>

      <div class="space-y-5">
        <div class="grid gap-5 md:grid-cols-2">
          <%= f.input :name,
                required: true,
                autofocus: true,
                input_html: {
                  autocomplete: "username",
                  class: "block w-full rounded-xl border border-slate-300 px-4 py-3 text-sm text-slate-900 shadow-sm placeholder:text-slate-400 focus:border-sky-500 focus:outline-none focus:ring-2 focus:ring-sky-100"
                },
                label_html: { class: "mb-2 block text-sm font-medium text-slate-700" } %>

          <%= f.input :email,
                required: true,
                input_html: {
                  autocomplete: "email",
                  class: "block w-full rounded-xl border border-slate-300 px-4 py-3 text-sm text-slate-900 shadow-sm placeholder:text-slate-400 focus:border-sky-500 focus:outline-none focus:ring-2 focus:ring-sky-100"
                },
                label_html: { class: "mb-2 block text-sm font-medium text-slate-700" } %>
        </div>

        <% if devise_mapping.confirmable? && resource.pending_reconfirmation? %>
          <p class="rounded-xl bg-amber-50 px-4 py-3 text-sm text-amber-800">
            현재 이메일 변경 확인 대기 중: <%= resource.unconfirmed_email %>
          </p>
        <% end %>

        <%= f.input :avatar,
              as: :file,
              required: false,
              input_html: {
                accept: "image/png,image/jpeg,image/webp,image/gif",
                class: "block w-full rounded-xl border border-slate-300 bg-white px-4 py-3 text-sm text-slate-900 file:mr-4 file:rounded-lg file:border-0 file:bg-sky-50 file:px-3 file:py-2 file:text-sm file:font-semibold file:text-sky-700 hover:file:bg-sky-100"
              },
              hint: "이미지 파일만 업로드할 수 있습니다.",
              label_html: { class: "mb-2 block text-sm font-medium text-slate-700" } %>

        <div class="grid gap-5 md:grid-cols-2">
          <%= f.input :password,
                hint: "비밀번호를 바꾸지 않으려면 비워두세요.",
                required: false,
                input_html: {
                  autocomplete: "new-password",
                  class: "block w-full rounded-xl border border-slate-300 px-4 py-3 text-sm text-slate-900 shadow-sm placeholder:text-slate-400 focus:border-sky-500 focus:outline-none focus:ring-2 focus:ring-sky-100"
                },
                label_html: { class: "mb-2 block text-sm font-medium text-slate-700" } %>

          <%= f.input :password_confirmation,
                required: false,
                input_html: {
                  autocomplete: "new-password",
                  class: "block w-full rounded-xl border border-slate-300 px-4 py-3 text-sm text-slate-900 shadow-sm placeholder:text-slate-400 focus:border-sky-500 focus:outline-none focus:ring-2 focus:ring-sky-100"
                },
                label_html: { class: "mb-2 block text-sm font-medium text-slate-700" } %>
        </div>

        <%= f.input :current_password,
              hint: "변경 사항 저장을 위해 현재 비밀번호를 입력하세요.",
              required: true,
              input_html: {
                autocomplete: "current-password",
                class: "block w-full rounded-xl border border-slate-300 px-4 py-3 text-sm text-slate-900 shadow-sm placeholder:text-slate-400 focus:border-sky-500 focus:outline-none focus:ring-2 focus:ring-sky-100"
              },
              label_html: { class: "mb-2 block text-sm font-medium text-slate-700" } %>
      </div>

      <div class="mt-6 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
        <div class="text-sm text-slate-500">
          비밀번호를 포함한 계정 변경은 Devise 기본 인증 규칙을 따릅니다.
        </div>

        <%= f.button :submit,
              "저장하기",
              class: "inline-flex items-center justify-center rounded-lg bg-blue-600 px-4 py-2 text-sm font-semibold text-white hover:bg-blue-700" %>
      </div>
    <% end %>
  </div>
</section>
