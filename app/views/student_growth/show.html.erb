<section class="mx-auto w-full max-w-6xl space-y-6 py-4" data-growth-dashboard>
  <%= render "shared/student_app_header", active: @tab %>

  <% if @tab == :growth %>
    <h1 class="text-2xl font-extrabold tracking-tight text-slate-900"><%= t("student_growth.title") %></h1>
    <%= render "shared/growth_weekly_chart", classroom: nil, student: nil %>
  <% elsif @editing %>
    <%= render "shared/growth_today_form" %>
  <% else %>
    <%= render "shared/growth_today_result",
          record: @record,
          score_rows: @score_rows,
          eyebrow: l(Time.zone.today, format: :long),
          status_text: nil,
          edit_path: student_growth_path(tab: "today", edit: 1) %>
  <% end %>
</section>
