<section class="mx-auto w-full max-w-6xl space-y-6 py-4" data-growth-dashboard>
  <%= render "shared/student_app_header", active: @tab %>

  <% if @tab == :weekly %>
    <h1 class="text-2xl font-extrabold tracking-tight text-slate-900"><%= t("student_growth.title") %></h1>
    <%= render "shared/growth_weekly_chart", classroom: nil, student: nil %>
  <% elsif @tab == :monthly %>
    <p class="py-8 text-center text-slate-500" data-growth-section="monthly"><%= t("student_app.navigation.coming_soon") %></p>
  <% else %>
    <%= render "shared/growth_daily_navigation", classroom: nil, student: nil %>
    <% if @editing %>
      <%= render "shared/growth_today_form" %>
    <% else %>
      <%= render "shared/growth_daily_result",
            record: @record,
            score_rows: @score_rows,
            eyebrow: nil,
            status_text: daily_growth_status(@record, @recorded_on),
            edit_path: @can_edit_record ? student_growth_path(tab: "growth", date: @recorded_on.iso8601, edit: 1) : nil %>
    <% end %>
  <% end %>
</section>
