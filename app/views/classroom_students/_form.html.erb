<%= turbo_frame_tag :modal do %>
  <div class="fixed inset-0 z-50 flex items-center justify-center bg-black/50" data-controller="modal">
    <div class="relative w-full max-w-md rounded-lg bg-white p-8 shadow-lg">
      <%= form_with model: student, url: classroom_students_path(classroom), data: { turbo_submits_with: t("ui.processing") } do |f| %>
        <%= hidden_field_tag :return_to, return_to if local_assigns[:return_to].present? %>
        <h2 class="mb-4 text-xl font-bold"><%= t("ui.buttons.create_student") %></h2>
        <% if student.errors.any? %>
          <div class="mb-4 rounded-lg border border-rose-200 bg-rose-50 px-3 py-2 text-sm text-rose-700"><%= student.errors.full_messages.to_sentence %></div>
        <% end %>
        <div class="mb-3">
          <%= f.label :student_number, t("students.form.student_number") %>
          <%= f.number_field :student_number, min: 1, step: 1, inputmode: "numeric", class: "w-full rounded border px-2 py-1" %>
          <p class="mt-1 text-xs text-gray-500"><%= t("students.form.student_number_hint") %></p>
        </div>
        <div class="mb-3">
          <%= f.label :name, t("ui.user_labels.name") %>
          <%= f.text_field :name, required: true, class: "w-full rounded border px-2 py-1" %>
        </div>
        <div class="mb-3">
          <%= f.label :gender, t("students.edit.self_pin.gender") %>
          <%= f.select :gender,
                [[t("students.edit.self_pin.genders.boy"), "boy"], [t("students.edit.self_pin.genders.girl"), "girl"]],
                { include_blank: t("students.bulk_create.errors.gender_required") },
                required: true,
                class: "w-full rounded border px-2 py-1" %>
        </div>
        <div class="mb-4">
          <%= f.label :student_pin, t("students.bulk_create.setup.student_pin") %>
          <%= f.password_field :student_pin, maxlength: 4, inputmode: "numeric", pattern: "\\d{4}", required: true, class: "w-full rounded border px-2 py-1" %>
        </div>
        <div class="flex gap-2">
          <%= f.submit t("ui.buttons.create_student"), class: "rounded bg-green-500 px-4 py-2 text-white" %>
          <button type="button" data-action="modal#close" class="rounded bg-gray-300 px-4 py-2"><%= t("ui.cancel") %></button>
        </div>
      <% end %>
      <button type="button" data-action="modal#close" class="absolute right-2 top-2 text-2xl text-gray-400" aria-label="<%= t("ui.cancel") %>">&times;</button>
    </div>
  </div>
<% end %>
