<section class="mx-auto w-full max-w-6xl pt-4 space-y-6" data-growth-dashboard>
  <%= render "classroom_students/student_profile_card",
        classroom: @classroom,
        student: @student,
        can_manage_student: @can_manage_student,
        can_manage_own_student_pin: false,
        student_active: @student.active? %>

  <%= render "shared/growth_dashboard_navigation",
        active: @tab,
        today_path: classroom_student_path(@classroom, @student),
        growth_path: classroom_student_path(@classroom, @student, tab: "growth") %>

  <% if @tab == :growth %>
    <%= render "shared/growth_weekly_chart", classroom: @classroom, student: @student %>
  <% else %>
    <%= render "shared/growth_today_result",
          record: @record,
          score_rows: @score_rows,
          eyebrow: @student.student_number.present? ? t("teacher_growth_records.student_number", number: @student.student_number) : t("teacher_growth_records.unassigned_student_number"),
          status_text: t(@record ? "teacher_growth_records.completed" : "teacher_growth_records.not_completed"),
          edit_path: nil %>
  <% end %>
</section>
