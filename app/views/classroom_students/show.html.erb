<section class="mx-auto w-full max-w-6xl pt-4 space-y-6">
  <%= render "classroom_students/student_profile_card",
        classroom: @classroom,
        student: @student,
        can_manage_student: @can_manage_student,
        can_manage_own_student_pin: false,
        student_active: @student.active? %>

  <section class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
    <p class="text-sm font-semibold text-blue-600">
      <%= @student.student_number.present? ? t("teacher_growth_records.student_number", number: @student.student_number) : t("teacher_growth_records.unassigned_student_number") %>
    </p>
    <h2 class="mt-1 text-xl font-extrabold tracking-tight text-slate-900">
      <%= t("daily_growth_records.title") %>
    </h2>
    <p class="mt-2 text-sm text-slate-700">
      <%= t(@record ? "teacher_growth_records.completed" : "teacher_growth_records.not_completed") %>
    </p>
  </section>

  <% if @record %>
    <section class="space-y-4">
      <% @score_rows.each do |score| %>
        <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
          <h3 class="text-lg font-bold text-slate-900"><%= score.fetch(:name) %></h3>
          <p class="mt-3 text-lg font-bold text-slate-900"><%= score.fetch(:value) %></p>
        </div>
      <% end %>

      <% if @record.reflection.present? %>
        <section class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
          <h3 class="text-lg font-bold text-slate-900"><%= t("daily_growth_records.reflection.label") %></h3>
          <p class="mt-3 whitespace-pre-wrap text-slate-800"><%= @record.reflection %></p>
        </section>
      <% end %>
    </section>
  <% end %>
</section>
