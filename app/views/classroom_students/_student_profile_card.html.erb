<%# locals: (classroom:, user:, can_manage_student:, student_active: true, can_manage_own_student_pin: false) %>

<section class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm" data-student-profile-card>
  <div class="grid gap-4 sm:grid-cols-[auto_minmax(0,1fr)_auto] sm:items-start">
    <%= user_avatar_image(
          user,
          size: 512,
          class: "h-24 w-24 shrink-0 rounded-2xl border border-slate-200 bg-slate-100 object-cover",
          alt: "#{user.name} avatar"
        ) %>

    <div class="min-w-0 flex-1">
      <div class="flex flex-wrap items-center gap-2">
        <h1 class="text-2xl font-extrabold tracking-tight text-slate-900"><%= user.name %></h1>
        <% unless student_active %>
          <span class="rounded-full bg-slate-100 px-2 py-0.5 text-xs font-semibold text-slate-600">
            <%= t("ui.inactive") %>
          </span>
        <% end %>
      </div>
      <p class="mt-1 text-sm font-medium text-slate-500"><%= classroom_display_name(classroom) %></p>
    </div>

    <% if can_manage_student %>
      <%= link_to t("students.show.actions.back_to_classroom"),
            classroom_path(classroom),
            class: "inline-flex shrink-0 items-center self-start rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm font-semibold text-slate-700 shadow-sm transition hover:border-slate-400 hover:bg-slate-50" %>
    <% end %>
  </div>

  <div class="mt-4 flex justify-end border-t border-slate-100 pt-4">
    <% if can_manage_student || can_manage_own_student_pin %>
      <div class="flex flex-wrap gap-2 lg:justify-end">
        <% if can_manage_own_student_pin %>
          <%= link_to t("students.show.actions.edit_pin"),
                edit_classroom_student_path(classroom, user),
                class: "inline-flex items-center rounded-lg border border-blue-300 bg-white px-3 py-2 text-sm font-semibold text-blue-700 shadow-sm transition hover:border-blue-400 hover:bg-blue-50" %>
        <% end %>
        <% if can_manage_student %>
          <%= link_to t("students.show.actions.edit_profile_and_pin"),
                edit_classroom_student_path(classroom, user),
                class: "inline-flex items-center rounded-lg border border-rose-300 bg-white px-3 py-2 text-sm font-semibold text-rose-700 shadow-sm transition hover:border-rose-400 hover:bg-rose-50" %>
        <% end %>
      </div>
    <% end %>
  </div>
</section>
